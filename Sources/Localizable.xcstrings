    "Codenotch is set to Always show. Change it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch 已設為「一律顯示」。請在設定裡更改。"
