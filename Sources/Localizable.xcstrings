          }
        }
      }
    },
    "Whatever is frontmost and full-screen gets the whole screen; the notch comes back when you leave it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "最前方的 App 進入全螢幕時，瀏海會隱藏；離開全螢幕後便會恢復。"
          }
