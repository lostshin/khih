    "Cancel schedule": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "取消預約"
          }
        }
      }
    },
    "Runs once for all enabled accounts. Codenotch must stay open; it waits while asleep or busy and cancels if more than one hour late.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "到點會依序處理所有啟用帳號，僅執行一次。Codenotch 需保持執行；睡眠或忙碌時會等候，逾時超過一小時則取消。"
          }
        }
      }
    },
    "Could not save the schedule: %@": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存預約：%@"
