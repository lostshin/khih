    "The notch stays open with every reading visible.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海保持展開，所有讀值都看得見。"
          }
        }
      }
    },
    "A small pill at the screen edge that opens when you reach it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕邊緣一顆小膠囊，游標移過去就會展開。"
          }
        }
      }
    },
    "Nothing on screen. Open Codenotch again from Applications to bring these settings back.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕上不顯示任何內容。從「應用程式」重新開啟 Codenotch，即可回到設定。"
          }
        }
      }
    },
