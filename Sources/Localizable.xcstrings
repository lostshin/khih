      }
    },
    "Alerts for %@ are muted. Click to unmute.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的提醒已靜音。點選取消靜音。"
          }
