          "stringUnit": {
            "state": "translated",
            "value": "已使用 %lld%% 的 %@ 額度。"
          }
        }
      }
    },
    "Moves to the display containing the window receiving keyboard input.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "移到正在接收鍵盤輸入的視窗所在的顯示器。"
